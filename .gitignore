# ROMs and ROM images: never commit
*.zip
*.rom
*.nv
*.nvm

# Quartus
output_files/
db/
incremental_db/
*.rpt
*.summary
*.done
*.pin
*.jdi
*.sof
*.srf
build_id.v
compile.log
# tools/build.py's build folders
/build/
qdb/
PLLJ_PLLSPE_INFO.txt

# simulation
sim/obj_*/
sim/emu/obj_*/
sim/*.log
sim/emu/*.log
artifacts/
*.ppm

# the tested release and its timing / fitter summaries
!releases/*.summary
jtag.cdf
c5_pin_model_dump.txt

# Python
__pycache__/
*.pyc

# the release zip (attach it to the GitHub release; tools/package.py); the release notes are kept
dist/*
!dist/RELEASE_NOTES_*.md


# the benches' build folders and the DSP's standalone Quartus project output
sim/**/obj_dir/
sim/dsp/quartus/output/
sim/dsp/quartus/db/
sim/dsp/quartus/incremental_db/
build.log
cr_ie_info.json

# the benches' generated data: never commit sim/game/img/, it is made from your MAME set (sim/game/mkhex.py)
sim/game/img/
sim/**/*.hex
sim/**/expected.txt
sim/**/got.txt
sim/**/build.log
sim/**/run.log
sim/**/fuzz_out/
sim/rot/*.png
sim/dsp/build/
